{
  "name": "puquprintjs",
  "version": "0.1.0",
  "description": "Framework-agnostic Web Bluetooth SDK for PUQU label printers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "puqu",
    "printer",
    "label-printer",
    "web-bluetooth",
    "ble",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
