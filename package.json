{
  "name": "puquprintjs",
  "version": "0.1.0",
  "description": "Framework-agnostic Web Bluetooth SDK for PUQU label printers",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run validate"
  },
  "keywords": [
    "puqu",
    "printer",
    "label-printer",
    "web-bluetooth",
    "ble",
    "typescript"
  ],
  "author": "puquprintJS contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
